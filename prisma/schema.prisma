generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String
  mode       String
  goal       String
  practices  String
  notes      String
  createdAt  DateTime @default(now())
}